        "@modelcontextprotocol/server-filesystem": [
          "search_files",
          "read_text_file"
        ],
        "@kazuph/mcp-taskmanager": [
          "request_planning"
        ]
      }
    },
    {
      "idx": 24,
      "question": "I want to turn yesterday’s log entries into actionable tasks. Please read the file at txt/log_yesterday.txt, analyze the problems mentioned in it, and then add a set of “To Do” items into a new task file named logs_tasks.md based on what needs follow‑up.",
