# Copy to .env locally. .env is ignored by Git; never commit your real API key.
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Fill in the model ID available to your account.
BIGMODEL_MODEL=glm-4-flash-250414
# Empty BIGMODEL_JUDGE_MODEL means use BIGMODEL_MODEL for development. Fix the judge for all strategies.
BIGMODEL_JUDGE_MODEL=
# Optional separate judge credential/endpoint; blank falls back to the Agent.
BIGMODEL_JUDGE_API_KEY=
BIGMODEL_JUDGE_BASE_URL=
# Optional second account, used only when listed in the JSON provider pool.
BIGMODEL_API_KEY_2=
# Formal models are set in the selected JSON profile, not these diagnostic variables.
BENCH_JUDGE_RUNS=5
PYTHONUTF8=1

# Additional independent accounts, as referenced by the selected provider pools.
BIGMODEL_API_KEY_3=
# The current formal knowledge profile references all five accounts.
BIGMODEL_API_KEY_4=
BIGMODEL_API_KEY_5=

# Knowledge updates only; model and budget are fixed in the JSON profile.
OPENROUTE_API_KEY=
OPENROUTE_BASE_URL=https://openrouter.ai/api/v1
