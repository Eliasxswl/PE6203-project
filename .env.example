# Copy to .env locally. .env is ignored by Git; never commit your real API key.
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Fill in the model ID available to your account.
BIGMODEL_MODEL=glm-4-flash-250414
# Empty means use BIGMODEL_MODEL for development. Fix the judge for all strategies.
BIGMODEL_JUDGE_MODEL=
BENCH_JUDGE_RUNS=5
PYTHONUTF8=1
